{% extends 'base.html.twig' %}

{% block title %}Inscription - TheWinners{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="text-center mb-4">Créer un compte</h2>

            {% if error %}
                <div class="alert alert-danger text-center">
                    {{ error }}
                </div>
            {% endif %}

            <form method="post" enctype="multipart/form-data" class="bg-secondary p-4 rounded shadow">

                <div class="mb-3">
                    <label for="username" class="form-label">Nom d'utilisateur</label>
                    <input type="text" name="username" id="username" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Adresse email</label>
                    <input type="email" name="email" id="email" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="birthdate" class="form-label">Date de naissance</label>
                    <input type="date" name="birthdate" id="birthdate" class="form-control">
                </div>

                <div class="mb-3">
                    <label for="avatar" class="form-label">Avatar</label>
                    <input type="file" name="avatar" id="avatar" class="form-control" accept="image/*">
                </div>

                <div class="mb-3 text-center">
                    <img id="avatarPreview" src="{{ avatar ? asset('uploads/avatars/' ~ avatar) : asset('assets/images/default-avatar.png') }}"
                         alt="Aperçu Avatar" class="rounded-circle shadow" width="100" height="100">
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input type="password" name="password" id="password" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="password_confirm" class="form-label">Confirmer le mot de passe</label>
                    <input type="password" name="password_confirm" id="password_confirm" class="form-control" required>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-danger">Créer mon compte</button>
                </div>
            </form>




            <p class="text-center mt-3">
                Déjà inscrit ? <a href="/login" class="link-light">Se connecter</a>
            </p>
        </div>
    </div>

    <script>
        const avatarInput = document.getElementById('avatar');
        const avatarPreview = document.getElementById('avatarPreview');

        avatarInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const url = URL.createObjectURL(file);
                avatarPreview.src = url;
            }
        });
    </script>
{% endblock %}
