{% extends 'base.html.twig' %}

{% block title %}Message reçu{% endblock %}

{% block content %}
    <div class="row justify-content-center text-center">
        <div class="col-md-8 col-lg-6">
            <h2>📨 Message</h2>
            <p><strong>De : {{ message.getSender.username }}</strong>
                {% set avatarPath = message.getSender.avatar ? 'uploads/avatars/' ~ message.getSender.avatar : 'assets/images/default-avatar.png' %}
                <img src="{{ asset(avatarPath) }}" class="rounded-circle me-2" width="40">

            </p>
            <p><strong>Reçu le :</strong> {{ message.getSentAt().format('d/m/Y H:i') }}</p>
            <hr>
            <p>{{ message.getContent }}</p>

            <form method="post" action="/messages/delete/{{ message.id }}">
                <button class="btn btn-danger">Supprimer</button>
                <a href="/messages/reply/{{ message.getSenderId() }}" class="btn btn-primary">Répondre</a>
                <a href="/messages" class="btn btn-secondary">Retour</a>

            </form>
        </div>
    </div>

{% endblock %}
