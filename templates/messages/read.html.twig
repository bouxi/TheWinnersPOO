{% extends 'base.html.twig' %}

{% block title %}Message reçu{% endblock %}

{% block content %}
    <div class="main-message">
        <div class="row justify-content-center text-center">
            <div class="col-md-6 col-lg-6">
                <h2 class="mb-4">📨 Message</h2>

                <div class="d-flex align-items-center justify-content-center mb-3">
                    {% set avatarPath = message.getSender.getAvatar
                        ? base_path ~ 'uploads/avatars/' ~ message.getSender.getAvatar
                        : base_path ~ 'assets/images/default-avatar.png' %}

                    <img src="{{ avatar_url(msg.getSender.getAvatar) }}"
                         alt="Avatar de {{ msg.getSender.getUsername }}"
                         class="avatar-img"
                         style="width: 46px; height: 46px; border-radius: 50%; object-fit: cover;">

                    <span><strong>De :</strong> {{ message.getSender.getUsername }}</span>
                </div>


                <p><strong>Reçu le :</strong> {{ message.getSentAt().format('d/m/Y H:i') }}</p>
                <hr>
                <p>{{ message.getContent }}</p>

                <form method="post" action="/messages/delete/{{ message.getId }}">
                    <button class="btn btn-danger">Supprimer</button>
                    <a href="/messages/reply/{{ message.getSenderId() }}" class="btn btn-primary">Répondre</a>
                    <a href="/messages" class="btn btn-secondary">Retour</a>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
