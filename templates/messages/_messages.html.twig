{% if messages is empty %}
    <p>Aucun message.</p>
{% else %}
    <ul class="list-group">
        {% for msg in messages %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div class="text-start">
                    <a href="/messages/read/{{ msg.id }}">
                        {{ msg.content|slice(0, 40) }}{% if msg.content|length > 40 %}...{% endif %}
                    </a><br>
                    <small>De : {{ msg.getSenderUsername }}</small>
                </div>

                <div class="text-end">
                    {% if not msg.isRead %}
                        <span class="badge bg-warning">Non lu</span>
                    {% endif %}

                    <form method="post" action="/messages/delete/{{ msg.id }}" class="d-inline">
                        <button class="btn btn-sm btn-outline-danger">🗑</button>
                    </form>

                    {# ✅ Bouton réponse rapide #}
                    <button class="btn btn-sm btn-outline-success"
                            onclick="openReplyModal({{ msg.getSenderId }}, '{{ msg.getSenderUsername }}')">
                        Répondre
                    </button>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endif %}
