{% extends 'base.html.twig' %}

{% block title %}Mes messages{% endblock %}

{% block content %}
    <div class="row justify-content-center text-center">
        <div class="col-md-6 col-lg-6">
            <h2>📥 Mes messages</h2>

            <div id="messages-container">
                {% include 'messages/_messages.html.twig' with { messages: messages } %}
            </div>

            <a href="/messages/new" class="btn btn-primary mt-3">Nouveau message</a>
        </div>
    </div>

    {# 🔽 Modale de réponse rapide #}
    <div class="modal fade" id="replyModal" tabindex="-1" aria-labelledby="replyModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="/messages/send" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="replyModalLabel">Répondre à <span id="replyUsername"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="recipient_id" id="replyRecipientId">
                    <textarea class="form-control" name="content" placeholder="Votre message..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Envoyer</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        setInterval(() => {
            console.log('🔄 Rafraîchissement automatique...');
            fetch('/messages/fetch')
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById('messages-container');
                    if (container) {
                        container.innerHTML = html;
                    }
                });
        }, 5000);

        // 🔁 Fonction pour ouvrir la modale avec infos utilisateur
        function openReplyModal(userId, username) {
            document.getElementById('replyRecipientId').value = userId;
            document.getElementById('replyUsername').textContent = username;
            const modal = new bootstrap.Modal(document.getElementById('replyModal'));
            modal.show();
        }
    </script>
{% endblock %}
