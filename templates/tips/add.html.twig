{% extends 'base.html.twig' %}

{% block title %}Ajouter une astuce{% endblock %}

{% block content %}
    <h2>Ajouter une nouvelle astuce</h2>

    <form action="/tips/add" method="POST">
        <div class="form-group">
            <label for="title">Titre</label>
            <input type="text" name="title" id="title" class="form-control" required>
        </div>

        <div class="form-group">
            <label for="category">Catégorie</label>
            <select name="category" id="category" class="form-control" required>
                <option value="addon">Addon</option>
                <option value="elvui">ElvUI</option>
                <option value="general">Conseils généraux</option>
            </select>
        </div>

        <div class="form-group">
            <label for="content">Contenu</label>
            <textarea name="content" id="content" class="form-control" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Publier</button>
    </form>
{% endblock %}
