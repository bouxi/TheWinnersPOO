<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}La guilde TheWinners{% endblock %}</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- favicon.ico -->
    <link rel="apple-touch-icon" sizes="180x180" href="{{ base_path }}/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ base_path }}/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ base_path }}/favicon-16x16.png">
    <link rel="manifest" href="{{ base_path }}/site.webmanifest">
    <link rel="shortcut icon" href="{{ base_path }}/favicon.ico">


    <!-- Ton CSS perso -->
    <link rel="stylesheet" href="/assets/css/style.css?v={{ "now"|date("U") }}">
    <link rel="stylesheet" href="{{ asset('../assets/css/style.css') }}">
</head>
<body class="bg-dark text-light">

{# Navbar classique en haut (optionnelle si tu veux la garder) #}
{% include 'partials/navbar.html.twig' %}

<!-- ✅ SIDEBAR + CONTENU -->
<div class="d-flex">
    <!-- 📌 SIDEBAR GAUCHE -->
    <nav class="bg-dark text-center text-white p-4 vh-100" style="width: 250px;">
        <ul class="nav flex-column">
            <h4>Nos guides</h4>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ base_path }}/en-travaux">
                    Guides des classes
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ base_path }}/en-travaux">
                    Raids
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ base_path }}/en-travaux">
                    Donjons
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ base_path }}/en-travaux">
                    Metiers
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ base_path }}/en-travaux">
                    Addons
                </a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ base_path }}/en-travaux">
                    Leveling
                </a>
            </li>

        </ul>
    </nav>

    <!-- 🔸 CONTENU PRINCIPAL -->
    <main class="flex-grow-1 p-4">
        <div id="notification-container"
             class="position-fixed top-0 start-50 translate-middle-x mt-3"
             style="z-index: 9999; max-width: 600px;">
        </div>

        {% block content %}
            {% if success %}
                <div class="alert alert-success text-center">
                    {{ success }}
                </div>
            {% endif %}

            {% if error %}
                <div class="alert alert-danger text-center">
                    {{ error }}
                </div>
            {% endif %}
        {% endblock %}
    </main>
</div>

<!-- 🔊 Sonnerie message -->
<audio id="messageSound" src="{{ base_path }}/assets/sounds/notification.mp3" preload="auto"></audio>

<!-- 🔌 Scripts JS globaux -->
<script>
    let lastCount = 0;
    function updateEnvelopeCount() {
        fetch('{{ base_path }}/messages/unread-count')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('message-count');
                const count = parseInt(data.count);
                if (badge) {
                    badge.textContent = count;
                    badge.style.display = (count === 0) ? 'none' : 'inline-block';
                }

                if (count > lastCount) {
                    const sound = document.getElementById('messageSound');
                    sound.play();

                    const toast = document.createElement('div');
                    toast.className = 'alert alert-info shadow';
                    toast.innerHTML = `<strong>Nouveau message !</strong> Vous avez ${count} message(s) non lu(s).`;

                    const container = document.getElementById('notification-container');
                    container.appendChild(toast);
                    setTimeout(() => toast.remove(), 5000);
                }

                lastCount = count;
            })
            .catch(err => console.error("Erreur compteur navbar:", err));
    }

    updateEnvelopeCount();
    setInterval(updateEnvelopeCount, 5000);
</script>

<!-- ✅ Chargement JS principal (App.js chargé sur toutes les pages) -->
<script src="{{ base_path }}/assets/js/App.js"></script>
{% block javascripts %}{% endblock %}

<!-- 🦶 Pied de page -->
{% include 'partials/footer.html.twig' %}

</body>
</html>
