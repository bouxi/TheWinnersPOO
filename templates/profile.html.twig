{% extends 'base.html.twig' %}

{% block title %}Mon profil - TheWinners{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="text-center mb-4">Profil de {{ username }}</h2>

            {% if success %}
                <div class="alert alert-success text-center">
                    {{ success }}
                </div>
            {% endif %}

            {% if error %}
                <div class="alert alert-danger text-center">
                    {{ error }}
                </div>
            {% endif %}

            <form method="post" action="/profile/update" class="bg-secondary p-4 rounded shadow">
                <div class="mb-3">
                    <label class="form-label">Nom d'utilisateur</label>
                    <input type="text" class="form-control" value="{{ username }}" disabled>
                </div>

                <div class="mb-3">
                    <label class="form-label">Adresse e-mail</label>
                    <input type="email" name="email" class="form-control" value="{{ email }}" required>
                </div>

                <hr class="my-4">

                <h5 class="text-white mb-3">Changer le mot de passe</h5>
                <div class="mb-3">
                    <label class="form-label">Nouveau mot de passe</label>
                    <input type="password" name="password" class="form-control">
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-danger">Mettre à jour</button>
                </div>
            </form>

            <div class="text-center mt-4">
                <span class="badge bg-light text-dark">Rôle actuel : <strong>{{ role }}</strong></span>
            </div>

            {% if isGuildMaster %}
                <div class="text-center mt-3">
                    <span class="badge bg-warning text-dark">Maître de Guilde 👑</span>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
