{% extends 'base.html.twig' %}

{% block title %}Connexion - TheWinners{% endblock %}

{% block content %}
    <div class="main-login">
        <div class="row justify-content-center text-center">
            <h2 class="text-center mb-4">Connexion à votre compte</h2>

            {% if flash_success %}
                <div class="alert alert-success text-center">{{ flash_success }}</div>
            {% endif %}
            {% if flash_error %}
                <div class="alert alert-danger text-center">{{ flash_error }}</div>
            {% endif %}

            <div class="col-md-5">
                <form method="post" action="{{ base_path }}/user/login" class="p-4 rounded shadow">
                    <!-- Nom d'utilisateur -->
                    <div class="mb-3">
                        <label for="username" class="form-label">Nom d'utilisateur</label>
                        <input type="text" id="username" name="username" class="form-control" required>
                    </div>

                    <!-- Mot de passe avec 👁️ -->
                    <div class="mb-3">
                        <label for="login_password" class="form-label">Mot de passe</label>
                        <div class="password-wrapper">
                            <input type="password" id="login_password" name="password" class="form-control" required>
                            <button type="button" class="toggle-password" data-target="login_password">👁️</button>
                        </div>
                    </div>

                    <!-- Bouton connexion -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger">Se connecter</button>
                    </div>
                </form>

                <!-- Lien mot de passe oublié -->
                <p class="mt-3 text-center">
                    <a href="{{ base_path }}/forgot-password" class="text-info">Mot de passe oublié ?</a>
                </p>

                {% if not user.username %}
                    <p class="text-center mt-2">
                        Pas encore membre ? <a href="{{ base_path }}/register" class="link-primary">Inscris-toi</a>
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
