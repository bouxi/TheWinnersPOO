{% extends 'base.html.twig' %}

{% block title %}Inscription - TheWinners{% endblock %}

{% block content %}
    <div class="main-register">
        <div class="text-center">
            <h2 class="mb-4" style="color: orange;">Créer un compte</h2>

            {% if error %}
                <div class="alert alert-danger text-center">
                    {{ error }}
                </div>
            {% endif %}

            <form method="post" enctype="multipart/form-data" class="formulaire-register">

                <div class="row">
                    <div class="col-md-6">
                        <label for="username" class="form-label">Nom d'utilisateur</label>
                        <input type="text" name="username" id="username" class="form-control" required>
                    </div>

                    <div class="col-md-6">
                        <label for="email" class="form-label">Adresse email</label>
                        <input type="email" name="email" id="email" class="form-control" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label for="birthdate" class="form-label">Date de naissance</label>
                        <input type="date" name="birthdate" id="birthdate" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label for="avatar" class="form-label">Avatar</label>
                        <input type="file" name="avatar" id="avatar" class="form-control" accept="image/*">

                        <div class="mt-2 text-center full-width">
                            <img id="avatarPreview"
                                 src="{% if user is defined and user.avatar and user.avatar != 'default-avatar.png' %}
                                        {{ base_path }}/uploads/avatars/{{ user.avatar }}
                                      {% else %}
                                        {{ base_path }}/assets/images/default-avatar.png
                                      {% endif %}"
                                 alt="Avatar"
                                 class="rounded-circle shadow"
                                 width="100" height="100"
                                 style="display: inline-block;">
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6 d-flex flex-column">
                        <label for="password" class="form-label">Mot de passe</label>
                        <div class="password-wrapper">
                            <input type="password" name="password" id="register_password" class="form-control" required>
                            <button type="button" class="toggle-password" data-target="register_password">👁️</button>
                        </div>

                        {# ✅ Inclusion du composant des règles #}
                        {% include 'components/_password_rules.html.twig' with { 'id': 'register' } %}
                    </div>

                    <div class="col-md-6 d-flex flex-column">
                        <label for="password_confirm" class="form-label">Confirmer le mot de passe</label>
                        <div class="password-wrapper">
                            <input type="password" name="password_confirm" id="password_confirm" class="form-control" required>
                            <button type="button" class="toggle-password" data-target="password_confirm">👁️</button>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-danger" id="submit-button-register">Créer mon compte</button>
                    <p class="mt-3">Déjà inscrit ? <a href="{{ base_path }}/login" class="link-light">Se connecter</a></p>
                </div>
            </form>
        </div>
    </div>

    <script>
        // 🖼️ Prévisualisation dynamique de l'avatar au choix du fichier
        const avatarInput = document.getElementById('avatar');
        const avatarPreview = document.getElementById('avatarPreview');

        avatarInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const url = URL.createObjectURL(file);
                avatarPreview.src = url;
            }
        });
    </script>

    {# ✅ Inclusion du JS global de validation mot de passe #}
    <script>
        setupPasswordRules('register', 'register_password');
    </script>
{% endblock %}
