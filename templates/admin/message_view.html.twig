{% extends 'admin/admin_base.html.twig' %}

{% block title %}Message #{{ message.id }}{% endblock %}

{% block content %}
    <h2>📨 Message #{{ message.id }}</h2>

    <ul class="list-group mb-4">
        <li class="list-group-item bg-dark text-light">
            <strong>Expéditeur :</strong> {{ message.senderUsername }}
        </li>
        <li class="list-group-item bg-dark text-light">
            <strong>Destinataire :</strong> {{ message.recipientUsername }}
        </li>
        <li class="list-group-item bg-dark text-light">
            <strong>Date :</strong> {{ message.created_at|date('d/m/Y H:i') }}
        </li>
        <li class="list-group-item bg-dark text-light">
            <strong>Lu :</strong> {{ message.is_read ? 'Oui' : 'Non' }}
        </li>
    </ul>

    <div class="card text-bg-secondary">
        <div class="card-body">
            <p>{{ message.content|nl2br }}</p>
        </div>
    </div>

    <a href="/admin/messages" class="btn btn-light mt-3">← Retour</a>
{% endblock %}
