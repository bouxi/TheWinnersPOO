{% extends 'admin/admin_base.html.twig' %}

{% block title %}Message #{{ message.id }}{% endblock %}

{% block content %}
    <h1 class="mb-4">👁 Lecture du message #{{ message.id }}</h1>

    <div class="card bg-dark text-light mb-3">
        <div class="card-header">
            De : <strong>{{ message.senderUsername }}</strong><br>
            À : <strong>{{ message.recipientUsername }}</strong><br>
            Date : {{ message.created_at|date('d/m/Y H:i') }}<br>
            Lu : {{ message.is_read ? 'Oui' : 'Non' }}
        </div>
        <div class="card-body">
            <p class="card-text">{{ message.content }}</p>
        </div>
    </div>

    <a href="/admin/messages" class="btn btn-secondary">⬅ Retour à la liste</a>
{% endblock %}
