{% extends 'admin/admin_base.html.twig' %}

{% block title %}Tableau de bord Admin{% endblock %}

{% block content %}
    <h1 class="text-center mb-4">🎛 Tableau de bord d'administration</h1>
    <small class="text-muted">Environnement actuel : {{ app_env|default('inconnu') }}</small>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-bg-dark border-success">
                <div class="card-body text-center">
                    <h5 class="card-title">Utilisateurs inscrits</h5>
                    <p class="display-5 fw-bold text-success">{{ totalUsers }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-dark border-warning">
                <div class="card-body text-center">
                    <h5 class="card-title">Messages non lus</h5>
                    <p class="display-5 fw-bold text-warning">{{ unreadMessages }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card text-bg-dark border-info">
                <div class="card-body">
                    <h5 class="card-title">Répartition des rôles</h5>
                    <ul class="list-group list-group-flush">
                        {% for role, count in rolesDistribution %}
                            <li class="list-group-item bg-dark text-light d-flex justify-content-between">
                                <span class="text-capitalize">{{ role }}</span>
                                <span class="badge bg-info">{{ count }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mt-4">🕵️‍♂️ Derniers inscrits</h3>
    <table class="table table-dark table-bordered table-hover mt-2">
        <thead class="table-active">
        <tr>
            <th>Avatar</th>
            <th>Nom d'utilisateur</th>
            <th>Email</th>
            <th>Rôle</th>
            <th>Date d’inscription</th>
        </tr>
        </thead>
        <tbody>
        {% for user in latestUsers %}
            <tr>
                <td>
                    <img src="{{ user.avatar ? '/uploads/avatars/' ~ user.avatar : '/assets/images/default-avatar.png' }}"
                         alt="avatar"
                         width="40" height="40" class="rounded-circle shadow">
                </td>
                <td>{{ user.username }}</td>
                <td>{{ user.email }}</td>
                <td><span class="badge bg-secondary">{{ user.role }}</span></td>
                <td>{{ user.dateInscription|date('d/m/Y H:i') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
