{% extends 'admin/admin_base.html.twig' %}

{% block title %}Candidature de {{ app.username }}{% endblock %}

{% block content %}
    <h2 class="mb-4">📄 Candidature de {{ app.username }}</h2>

    <table class="table table-dark table-bordered w-75 mx-auto">
        <tbody>
        <tr>
            <th>Joueur</th>
            <td>{{ app.username }}</td>
        </tr>
        <tr>
            <th>Classe</th>
            <td>{{ app.class }}</td>
        </tr>
        <tr>
            <th>Spécialisation</th>
            <td>{{ app.specialization }}</td>
        </tr>
        <tr>
            <th>Temps de jeu</th>
            <td>{{ app.playtime }}</td>
        </tr>
        <tr>
            <th>Disponibilités</th>
            <td>{{ app.availability|nl2br }}</td>
        </tr>
        <tr>
            <th>Motivation</th>
            <td>{{ app.motivation|nl2br }}</td>
        </tr>
        <tr>
            <th>Date de soumission</th>
            <td>{{ app.submitted_at|date('d/m/Y H:i') }}</td>
        </tr>
        <tr>
            <th>Statut</th>
            <td>
                {% if app.status == 'pending' %}
                    <span class="badge bg-warning text-dark">En attente</span>
                {% elseif app.status == 'accepted' %}
                    <span class="badge bg-success">Acceptée</span>
                {% elseif app.status == 'refused' %}
                    <span class="badge bg-danger">Refusée</span>
                {% endif %}
            </td>
        </tr>
        </tbody>
    </table>

    <div class="mt-4 text-center">
        <a href="{{ base_path }}/admin/applications" class="btn btn-secondary">← Retour à la liste</a>
    </div>
{% endblock %}
