{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe - TheWinners{% endblock %}

{% block content %}
    <div class="reset-box">
        <h2 class="text-center mb-4">Réinitialiser mon mot de passe</h2>

        {% if error %}
            <div class="alert alert-danger text-center">{{ error }}</div>
        {% endif %}

        {% if success %}
            <div class="alert alert-success text-center">{{ success }}</div>
        {% else %}
            <form method="post" action="{{ base_path }}/reset-password/{{ token }}" class="form-reset">

                <div class="mb-3">
                    <label for="reset_password" class="form-label">Nouveau mot de passe</label>
                    <div class="password-wrapper">
                        <input type="password" name="password" id="reset_password" class="form-control" required>
                        <button type="button" class="toggle-password" data-target="reset_password">👁️</button>
                    </div>

                    {% include 'components/_password_rules.html.twig' with { 'id': 'reset' } %}
                </div>

                <div class="mb-3">
                    <label for="reset_password_confirm" class="form-label">Confirmer le mot de passe</label>
                    <div class="password-wrapper">
                        <input type="password" name="confirm_password" id="reset_password_confirm" class="form-control" required>
                        <button type="button" class="toggle-password" data-target="reset_password_confirm">👁️</button>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-danger" id="submit-button-reset">Valider</button>
                </div>

                <p class="text-center mt-3">
                    <a href="{{ base_path }}/user/login" class="retour-login">Retour à la connexion</a>
                </p>
            </form>
        {% endif %}
    </div>



{% endblock %}
