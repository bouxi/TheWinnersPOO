{% extends 'base.html.twig' %}

{% block title %}Connexion - TheWinners{% endblock %}

{% block content %}
    <div class="main">
        <div class="row justify-content-center text-center">
            <h2 class="text-center mb-4">Connexion à votre compte</h2>
            <div class="col-md-4">
                {% if error %}
                    <div class="alert alert-danger text-center">
                        {{ error }}
                    </div>
                {% endif %}

                <form method="post" action="{{ base_path }}/login" class="p-4 rounded shadow">
                    <div class="mb-3">
                        <label for="username" class="form-label">Nom d'utilisateur</label>
                        <input type="text" id="username" name="username" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" id="password" name="password" class="form-control" required>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger">Se connecter</button>
                    </div>
                </form>
                <p class="mt-3 text-center">
                    <a href="{{ base_path }}/forgot-password" class="text-info">Mot de passe oublié ?</a>
                </p>
                {% if not user.username %}
                <p class="text-center mt-2">
                    Pas encore membre ? <a href="{{ base_path }}/register" class="link-primary">Inscrit toi</a>
                </p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
