<nav class="navbar navbar-expand-lg navbar">
    <div class="container-fluid">

        {# Logo + Nom #}
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="{{ asset('../assets/images/icons8-world-of-warcraft-48.png') }}"
                 alt="TheWinners"
                 width="46" height="46"
                 class="me-2">
            <span class="fw-bold">TheWinners</span>
        </a>

        {# Bouton pour le menu mobile #}
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNavDropdown"
                aria-controls="navbarNavDropdown"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        {# Contenu de la navbar #}
        <div class="collapse navbar-collapse justify-content-between" id="navbarNavDropdown">
            <ul class="navbar-nav me-auto">
                {# Liens principaux (gauche ou vide ici) #}
            </ul>

            {# Avatar + nom utilisateur à droite #}
            {% if isAuthenticated %}
                <div class="d-flex align-items-center me-3">
                    <a href="/profile" class="text-white text-decoration-none me-2 fw-semibold">
                        {{ user.username }}
                    </a>
                    <img src="{{ user and user.avatar ? base_path ~ '/uploads/avatars/' ~ user.avatar : base_path ~ '/assets/images/default-avatar.png' }}"
                         alt="Avatar de {{ user.username }}"
                         class="rounded-circle shadow"
                         width="40" height="40">
                </div>

                {% if isAuthenticated %}
                    <a href="/messages" class="position-relative text-light mx-2">
                        <i class="fas fa-envelope"></i>
                        {% if unreadMessages > 0 %}
                            <span id="message-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{ unreadMessages|default(0) }}
                            </span>
                        {% endif %}
                    </a>
                {% endif %}




            {% endif %}

            <ul class="navbar-nav">
                {% if isAuthenticated %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}profile">Mon Profil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/logout">Déconnexion</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/login">Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/register">Inscription</a>
                    </li>
                {% endif %}
                {% if app.user is defined and app.user.role in ['admin', 'guild_master'] %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/admin">Admin</a>
                    </li>
                {% endif %}

            </ul>
        </div>
    </div>
</nav>

{% block javascripts %}
    <script>
        lastCount = 0;

        function updateEnvelopeCount() {
            fetch('/messages/unread-count')
                .then(res => res.json())
                .then(data => {
                    const badge = document.getElementById('message-count');
                    const count = parseInt(data.count);
                    if (badge) {
                        badge.textContent = count;
                        badge.style.display = (count === 0) ? 'none' : 'inline-block';
                    }

                    if (count > lastCount) {
                        // 🆕 Nouveau message !
                        const sound = document.getElementById('messageSound');
                        sound.play();


                    }

                    var lastCount = count;
                })
                .catch(err => console.error("Erreur compteur navbar:", err));
        }

        setInterval(updateEnvelopeCount, 10000);
        updateEnvelopeCount();

    </script>


{% endblock %}