<nav class="navbar navbar-expand-lg navbar">
    <div class="container-fluid">

        {# Logo + Nom #}
        <a class="navbar-brand d-flex align-items-center" href="{{ base_path }}/">
            <img src="{{ base_path }}/assets/images/icons8-world-of-warcraft-48.png"
                 alt="Logo TheWinners"
                 width="48" height="48"
                 class="me-2">
            <span class="fw-bold">Accueil</span>
        </a>

        {# Bouton responsive #}
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNavDropdown"
                aria-controls="navbarNavDropdown"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        {# Contenu navbar #}
        <div class="collapse navbar-collapse justify-content-between" id="navbarNavDropdown">

            {# Liens à gauche (optionnels) #}
            <ul class="navbar-nav me-auto">
                {# Exemple : <li class="nav-item"><a class="nav-link" href="#">Lien</a></li> #}
            </ul>

            {# Avatar, nom utilisateur et messages à droite #}
            {% if isAuthenticated %}
                <div class="d-flex align-items-center me-3">
                    <a href="{{ base_path }}/user/profile" class="text-white text-decoration-none me-2 fw-semibold">
                        {{ user.username }}
                    </a>
                    <img src="{{ avatar_url(user.avatar) }}"
                         alt="Avatar de {{ user.username }}"
                         class="rounded-circle shadow"
                         width="40" height="40">
                </div>

                <a href="{{ base_path }}/messages" class="position-relative text-light mx-2" aria-label="Messages">
                    <i class="fas fa-envelope fa-lg"></i>
                    {% if unreadMessages > 0 %}
                        <span id="message-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            {{ unreadMessages }}
                        </span>
                    {% else %}
                        <span id="message-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
                            0
                        </span>
                    {% endif %}
                </a>
            {% endif %}

            {# Liens à droite #}
            <ul class="navbar-nav">
                {% if isAuthenticated %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/user/profile">Mon Profil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/user/logout">Déconnexion</a>
                    </li>

                    {% if user.role in ['admin', 'guild_master'] %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ base_path }}/admin">Admin</a>
                        </li>
                    {% endif %}
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/user/login">Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ base_path }}/user/register">Inscription</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

{# 🔔 Son notification message #}
<audio id="messageSound" src="{{ base_path }}/assets/sounds/notification.mp3" preload="auto"></audio>

{% block javascripts %}
    <script>
        let lastCount = {{ unreadMessages|default(0) }};

        function updateEnvelopeCount() {
            fetch('{{ base_path }}/messages/unread-count')
                .then(res => res.json())
                .then(data => {
                    const badge = document.getElementById('message-count');
                    const count = parseInt(data.count);

                    if (badge) {
                        badge.textContent = count;
                        badge.style.display = count > 0 ? 'inline-block' : 'none';
                    }

                    if (count > lastCount) {
                        const sound = document.getElementById('messageSound');
                        if (sound) sound.play();
                    }

                    lastCount = count;
                })
                .catch(err => console.error("Erreur compteur navbar:", err));
        }

        setInterval(updateEnvelopeCount, 10000);
        updateEnvelopeCount();
    </script>
{% endblock %}
